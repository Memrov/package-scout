{
  "schema_version": 1,
  "about": "Jobs the platform already does. When a search asks for one of these, Scout answers with the built-in before any package. A package is for a rabbit hole, never for a few lines. Every `verify` expression runs in the test suite.",
  "entries": [
    {
      "id": "pad-start",
      "phrases": ["left pad", "leftpad", "pad left", "pad start", "padstart", "pad string", "zero pad", "zero padding", "pad number", "leading zeros"],
      "with": ["string", "number", "zero"],
      "runtimes": ["browser", "node"],
      "builtin": "String.prototype.padStart()",
      "example": "String(7).padStart(3, '0') // '007'",
      "verify": "String(7).padStart(3, '0') === '007'",
      "limits": "It counts UTF-16 code units, so emoji and combining characters throw the width off.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/String/padStart",
      "note": "The internet broke over an 11-line version of this in 2016. It has been built in since 2017."
    },
    {
      "id": "deep-clone",
      "phrases": ["deep clone", "deepclone", "deep copy", "clone object", "copy object", "structured clone"],
      "with": ["object", "array", "json"],
      "runtimes": ["browser", "node"],
      "builtin": "structuredClone()",
      "example": "const copy = structuredClone(original)",
      "verify": "(() => { const a = { when: new Date(0), nested: { list: [1] } }; const b = structuredClone(a); return b !== a && b.nested.list !== a.nested.list && b.when instanceof Date && b.nested.list[0] === 1; })()",
      "needs": "Node 17+ and every major browser since 2022",
      "limits": "It throws on functions and DOM nodes, and class instances come back as plain objects.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/Window/structuredClone",
      "note": "JSON.parse(JSON.stringify(x)) can finally retire."
    },
    {
      "id": "uuid",
      "phrases": ["uuid", "uuid v4", "uuidv4", "guid", "random uuid", "random id", "unique id", "generate uuid"],
      "with": ["generate", "generator", "random", "id", "v4", "unique", "create"],
      "runtimes": ["browser", "node"],
      "builtin": "crypto.randomUUID()",
      "example": "const id = crypto.randomUUID()",
      "verify": "/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/.test(crypto.randomUUID())",
      "needs": "Node 19+ and every major browser, on HTTPS pages only",
      "limits": "Version 4 only. For time-sortable v7, name-based v5 or validating UUIDs, use a package.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/Crypto/randomUUID"
    },
    {
      "id": "fetch",
      "phrases": ["fetch", "http client", "http request", "http get", "ajax", "rest client", "api request", "node fetch"],
      "with": ["http", "request", "client", "api", "json", "get", "post"],
      "runtimes": ["browser", "node"],
      "builtin": "fetch()",
      "example": "const data = await (await fetch(url)).json()",
      "verify": "typeof fetch === 'function'",
      "needs": "Node 18+ and every browser",
      "limits": "No retries, interceptors or upload progress. It only rejects on network failure, so check response.ok yourself.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API/Using_Fetch"
    },
    {
      "id": "request-timeout",
      "phrases": ["fetch timeout", "request timeout", "http timeout", "abort timeout", "timeout signal"],
      "with": ["fetch", "request", "http", "abort"],
      "runtimes": ["browser", "node"],
      "builtin": "AbortSignal.timeout()",
      "example": "const response = await fetch(url, { signal: AbortSignal.timeout(5000) })",
      "verify": "AbortSignal.timeout(1000) instanceof AbortSignal",
      "needs": "Node 18+ and every major browser since 2022",
      "limits": "It cancels the request. Retrying afterwards is still on you.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/AbortSignal/timeout_static"
    },
    {
      "id": "format-number",
      "phrases": ["format number", "number format", "number formatting", "format currency", "currency format", "currency formatting", "format money", "thousands separator", "compact number"],
      "with": ["number", "currency", "money", "locale", "intl"],
      "runtimes": ["browser", "node"],
      "builtin": "Intl.NumberFormat",
      "example": "new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(1234.5) // '$1,234.50'",
      "verify": "new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(1234.5) === '$1,234.50'",
      "limits": "Display only. It will not parse '$1,234.50' back into a number or do currency math.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/NumberFormat"
    },
    {
      "id": "format-date",
      "phrases": ["format date", "date format", "date formatting", "format time", "date to string"],
      "with": ["date", "time", "locale", "intl", "string"],
      "runtimes": ["browser", "node"],
      "builtin": "Intl.DateTimeFormat",
      "example": "new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(new Date()) // 'Nov 17, 2026'",
      "verify": "new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, 10, 17))) === 'Nov 17, 2026'",
      "limits": "Formatting only. Date math, parsing odd strings and time zone arithmetic are a real rabbit hole, and worth a package.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/DateTimeFormat"
    },
    {
      "id": "relative-time",
      "phrases": ["relative time", "time ago", "timeago", "relative date", "humanize time"],
      "with": ["time", "date", "format"],
      "runtimes": ["browser", "node"],
      "builtin": "Intl.RelativeTimeFormat",
      "example": "new Intl.RelativeTimeFormat('en', { numeric: 'auto' }).format(-1, 'day') // 'yesterday'",
      "verify": "new Intl.RelativeTimeFormat('en', { numeric: 'auto' }).format(-1, 'day') === 'yesterday'",
      "limits": "You choose the unit. It will not decide between '90 minutes ago' and '2 hours ago' for you.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/RelativeTimeFormat"
    },
    {
      "id": "query-string",
      "phrases": ["query string", "querystring", "query params", "query parameters", "url params", "url parameters", "search params", "parse query string"],
      "with": ["url", "parse", "stringify", "build"],
      "runtimes": ["browser", "node"],
      "builtin": "URLSearchParams",
      "example": "new URLSearchParams({ q: 'csv parser', page: '2' }).toString() // 'q=csv+parser&page=2'",
      "verify": "new URLSearchParams({ q: 'csv parser', page: '2' }).toString() === 'q=csv+parser&page=2' && new URLSearchParams('a=1&b=two').get('b') === 'two'",
      "limits": "Flat key and value pairs only. Nested objects and bracket arrays such as a[]=1 need a package.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/URLSearchParams"
    },
    {
      "id": "group-by",
      "phrases": ["group by", "groupby", "group array", "array group by", "group objects"],
      "with": ["array", "object", "key", "list"],
      "runtimes": ["browser", "node"],
      "builtin": "Object.groupBy()",
      "example": "const byTeam = Object.groupBy(people, person => person.team)",
      "verify": "JSON.stringify(Object.groupBy([1, 2, 3], n => (n % 2 ? 'odd' : 'even'))) === '{\"odd\":[1,3],\"even\":[2]}'",
      "needs": "Node 21+ and every major browser since March 2024",
      "limits": "Keys become strings. Use Map.groupBy() when the key is an object.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Object/groupBy"
    },
    {
      "id": "unique-array",
      "phrases": ["unique array", "array unique", "unique values", "dedupe", "dedupe array", "deduplicate", "remove duplicates", "uniq"],
      "with": ["array", "list", "values", "items"],
      "runtimes": ["browser", "node"],
      "builtin": "Set",
      "example": "const unique = [...new Set(items)]",
      "verify": "[...new Set([1, 2, 2, 3, 1])].join() === '1,2,3'",
      "limits": "It compares by identity, so two equal-looking objects both stay. Key those through a Map.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Set"
    },
    {
      "id": "flatten-array",
      "phrases": ["flatten array", "array flatten", "flat array", "flatten nested array"],
      "with": ["array", "nested", "deep"],
      "runtimes": ["browser", "node"],
      "builtin": "Array.prototype.flat()",
      "example": "const flat = nested.flat(Infinity)",
      "verify": "[1, [2, [3, [4]]]].flat(Infinity).join() === '1,2,3,4'",
      "limits": "Arrays only. Flattening nested objects into dotted keys is a different job.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Array/flat"
    },
    {
      "id": "sleep",
      "phrases": ["sleep", "sleep promise", "promise sleep", "async sleep", "promise delay", "delay promise", "wait milliseconds"],
      "with": ["promise", "async", "await", "timeout", "ms", "milliseconds"],
      "runtimes": ["browser", "node"],
      "builtin": "setTimeout() in a Promise",
      "example": "await new Promise(resolve => setTimeout(resolve, 500))",
      "verify": "new Promise(resolve => setTimeout(() => resolve(true), 1))",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/Window/setTimeout",
      "note": "One line. On Node, node:timers/promises exports the same thing ready-made."
    },
    {
      "id": "is-odd",
      "phrases": ["is odd", "isodd", "is even", "iseven", "odd even", "odd or even", "check odd", "check even"],
      "with": ["number", "check", "integer"],
      "runtimes": ["browser", "node"],
      "builtin": "the % operator",
      "example": "const isOdd = n => n % 2 !== 0",
      "verify": "[1, 2, 3, -1].filter(n => n % 2 !== 0).length === 3",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Operators/Remainder",
      "note": "Scout isn't angry. Scout is disappointed."
    },
    {
      "id": "parse-args",
      "phrases": ["argument parser", "parse arguments", "args parser", "argv parser", "parse argv", "command line arguments", "command line parser", "command line options", "cli arguments", "cli parser", "parse flags"],
      "with": ["cli", "command", "line", "argv", "option", "flag"],
      "runtimes": ["node"],
      "builtin": "util.parseArgs()",
      "example": "import { parseArgs } from 'node:util';\nconst { values } = parseArgs({ options: { name: { type: 'string' }, verbose: { type: 'boolean', short: 'v' } } });",
      "verify": "(() => { const { values } = require('node:util').parseArgs({ args: ['--name', 'scout', '-v'], options: { name: { type: 'string' }, verbose: { type: 'boolean', short: 'v' } } }); return values.name === 'scout' && values.verbose === true; })()",
      "needs": "Node 20+",
      "limits": "Flags and positionals only. Subcommands, generated help text and validation are yours to write, or a package's.",
      "docs": "https://nodejs.org/api/util.html"
    },
    {
      "id": "env-file",
      "phrases": ["dotenv", "env file", "load env", "load env file", "read env file", "env loader", "environment variables file"],
      "with": ["env", "file", "load", "environment", "variable", "config"],
      "runtimes": ["node"],
      "builtin": "node --env-file",
      "example": "node --env-file=.env server.js\n// or, inside the program: process.loadEnvFile()",
      "verify": "typeof process.loadEnvFile === 'function'",
      "needs": "Node 20.6+ for the flag, 20.12+ for process.loadEnvFile()",
      "limits": "Plain KEY=value files with comments, quotes and multi-line values. If you rely on dotenv extras such as variable expansion, check the Node docs first.",
      "docs": "https://nodejs.org/api/cli.html#--env-filefile"
    },
    {
      "id": "test-runner",
      "phrases": ["test runner", "unit test", "unit testing", "testing framework", "test framework"],
      "with": ["node", "test", "run"],
      "runtimes": ["node"],
      "builtin": "node:test",
      "example": "import test from 'node:test';\nimport assert from 'node:assert/strict';\ntest('adds', () => assert.equal(1 + 1, 2));\n// run it with: node --test",
      "verify": "typeof require('node:test') === 'function' && typeof require('node:assert/strict').equal === 'function'",
      "needs": "Node 20+",
      "limits": "Built for Node code. Component and in-browser tests still want a full framework.",
      "docs": "https://nodejs.org/api/test.html",
      "note": "Scout's own test suite runs on it."
    },
    {
      "id": "terminal-colors",
      "phrases": ["terminal colors", "ansi colors", "console colors", "colored output", "color terminal", "terminal styling", "cli colors"],
      "with": ["terminal", "console", "cli", "text", "output", "string"],
      "runtimes": ["node"],
      "builtin": "util.styleText()",
      "example": "import { styleText } from 'node:util';\nconsole.log(styleText('green', 'done'));",
      "verify": "require('node:util').styleText('green', 'done').includes('done')",
      "needs": "Node 22.13+",
      "limits": "Named styles and colors only. Spinners, boxes and gradients are someone else's package.",
      "docs": "https://nodejs.org/api/util.html"
    },
    {
      "id": "watch-mode",
      "phrases": ["watch mode", "restart on change", "auto restart", "reload on change", "auto reload", "restart server on change"],
      "with": ["node", "server", "file", "dev", "development"],
      "runtimes": ["node"],
      "builtin": "node --watch",
      "example": "node --watch server.js",
      "verify": "process.allowedNodeEnvironmentFlags.has('--watch')",
      "needs": "Node 22+, or 20.13+",
      "limits": "It restarts the process when an imported file changes. It does not hot-reload a browser.",
      "docs": "https://nodejs.org/api/cli.html#--watch"
    },
    {
      "id": "deep-equal",
      "phrases": ["deep equal", "deep equality", "deep compare", "compare objects", "object equality", "isequal", "is equal"],
      "with": ["object", "array", "strict"],
      "runtimes": ["node"],
      "builtin": "util.isDeepStrictEqual()",
      "example": "import { isDeepStrictEqual } from 'node:util';\nisDeepStrictEqual({ a: [1, 2] }, { a: [1, 2] }) // true",
      "verify": "require('node:util').isDeepStrictEqual({ a: [1, 2] }, { a: [1, 2] }) === true && require('node:util').isDeepStrictEqual({ a: 1 }, { a: '1' }) === false",
      "limits": "Node only. The browser has no built-in for this, so there it is a fair job for a package.",
      "docs": "https://nodejs.org/api/util.html"
    },
    {
      "id": "websocket-client",
      "phrases": ["websocket client"],
      "with": ["connect", "connection"],
      "runtimes": ["browser", "node"],
      "builtin": "WebSocket",
      "example": "const socket = new WebSocket('wss://example.com/feed');\nsocket.addEventListener('message', event => console.log(event.data));",
      "verify": "typeof WebSocket === 'function'",
      "needs": "Node 22+ and every browser",
      "limits": "Client only, with no automatic reconnect. A WebSocket server on Node still needs a package.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/WebSocket"
    },
    {
      "id": "date-picker",
      "phrases": ["date picker", "datepicker", "date input", "calendar picker", "date selector"],
      "with": ["input", "form", "html", "calendar"],
      "runtimes": ["browser"],
      "builtin": "<input type=\"date\">",
      "example": "<input type=\"date\" name=\"due\" min=\"2026-01-01\">",
      "limits": "It looks different in every browser, and it cannot do date ranges or disable arbitrary days.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/input/date",
      "note": "The browser has shipped a calendar for years. It even handles the keyboard."
    },
    {
      "id": "color-picker",
      "phrases": ["color picker", "colour picker", "colorpicker", "color input"],
      "with": ["input", "form", "html"],
      "runtimes": ["browser"],
      "builtin": "<input type=\"color\">",
      "example": "<input type=\"color\" name=\"accent\" value=\"#2f6f4f\">",
      "limits": "You get the operating system's picker, so you cannot restyle it.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/input/color"
    },
    {
      "id": "modal-dialog",
      "phrases": ["modal", "modal dialog", "dialog", "popup dialog", "modal window"],
      "with": ["html", "window", "popup", "component"],
      "runtimes": ["browser"],
      "builtin": "<dialog>",
      "example": "<dialog id=\"confirm\"><form method=\"dialog\"><button>OK</button></form></dialog>\n<script>document.querySelector('#confirm').showModal()</script>",
      "needs": "every major browser since 2022",
      "limits": "Focus trapping, Esc to close and the backdrop are included. Styling and animation are yours.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/dialog"
    },
    {
      "id": "clipboard",
      "phrases": ["clipboard", "copy to clipboard", "clipboard copy", "copy text"],
      "with": ["text", "button", "copy"],
      "runtimes": ["browser"],
      "builtin": "navigator.clipboard.writeText()",
      "example": "await navigator.clipboard.writeText(text)",
      "limits": "HTTPS pages only, and browsers expect it to follow a click.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/API/Clipboard/writeText"
    },
    {
      "id": "accordion",
      "phrases": ["accordion", "collapsible", "collapsible section", "expand collapse", "disclosure"],
      "with": ["html", "section", "component", "panel"],
      "runtimes": ["browser"],
      "builtin": "<details> and <summary>",
      "example": "<details><summary>Shipping</summary>Arrives in 3 days.</details>",
      "limits": "Animating the open and close takes extra CSS.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/HTML/Reference/Elements/details"
    },
    {
      "id": "lazy-images",
      "phrases": ["lazy load images", "lazy loading images", "image lazy loading", "lazy image", "lazyload image"],
      "with": ["image", "img", "html"],
      "runtimes": ["browser"],
      "builtin": "loading=\"lazy\"",
      "example": "<img src=\"photo.jpg\" loading=\"lazy\" width=\"800\" height=\"600\" alt=\"A photo\">",
      "needs": "every major browser since 2022",
      "limits": "Images and iframes only. Lazy-loading components or data is a different job.",
      "docs": "https://developer.mozilla.org/en-US/docs/Web/Performance/Guides/Lazy_loading"
    }
  ]
}
