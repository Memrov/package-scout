{
  "name": "package-scout",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "plugin:build": "node scripts/build-claude-plugin.mjs",
    "plugin:check": "node scripts/build-claude-plugin.mjs --check",
    "npm:build": "node scripts/build-npm-package.mjs",
    "npm:check": "node scripts/build-npm-package.mjs --check",
    "validate": "node scripts/validate-artifact.mjs",
    "check": "tsc --noEmit",
    "dev": "node scripts/preview.ts",
    "test:live": "node scripts/smoke-test.ts",
    "test": "node scripts/build-claude-plugin.mjs --check && node scripts/build-npm-package.mjs --check && node scripts/build-replacements.mjs --check && node --test scripts/refresh-catalog.test.ts scripts/replacements.test.ts worker/index.test.ts worker/input.fuzz.test.ts scripts/evaluate-package.test.mjs challenges/csv/challenge.test.mjs scripts/mcp-stdio.test.mjs scripts/npm-package.test.mjs benchmarks/search/benchmark.test.mjs",
    "test:fuzz": "node --test worker/input.fuzz.test.ts",
    "mcp": "node scripts/mcp-stdio.mjs",
    "test:npm": "node --test scripts/npm-package.test.mjs",
    "evaluate": "node scripts/evaluate-package.mjs",
    "catalog:refresh": "node scripts/refresh-catalog.ts",
    "challenge": "node challenges/csv/run.mjs",
    "holes": "node scripts/rabbit-holes.ts",
    "benchmark": "node benchmarks/search/run.mjs",
    "replacements:build": "node scripts/build-replacements.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "module-replacements": "3.4.0",
    "typescript": "7.0.2"
  }
}
